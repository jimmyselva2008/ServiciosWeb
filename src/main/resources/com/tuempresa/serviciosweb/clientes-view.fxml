<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tuempresa.serviciosweb.controller.ClienteController"
      prefWidth="1200.0" prefHeight="600.0" spacing="14.0"
      style="-fx-background-color: #f2f6fa;">

    <padding>
        <Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label text="Clientes de Supabase"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Button fx:id="btnConsultar" text="Consultar clientes"/>
    </HBox>

    <Label fx:id="lblEstado" text="Presioná Consultar clientes" wrapText="true"/>

    <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="55.0"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="120.0"/>
            <TableColumn fx:id="colApellido" text="Apellido" prefWidth="125.0"/>
            <TableColumn fx:id="colCorreo" text="Correo" prefWidth="210.0"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="140.0"/>
            <TableColumn fx:id="colFechaNacimiento" text="Fecha de nacimiento" prefWidth="155.0"/>
            <TableColumn fx:id="colPais" text="País" prefWidth="105.0"/>
            <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="110.0"/>
            <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="195.0"/>
            <TableColumn fx:id="colIngresoAnual" text="Ingreso anual" prefWidth="115.0"/>
            <TableColumn fx:id="colPuntajeCrediticio" text="Puntaje crediticio" prefWidth="140.0"/>
            <TableColumn fx:id="colDeudaImpaga" text="Deuda impaga" prefWidth="115.0"/>
            <TableColumn fx:id="colMontoDeuda" text="Monto de deuda" prefWidth="130.0"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="95.0"/>
            <TableColumn fx:id="colCreacion" text="Creado el" prefWidth="245.0"/>
            <TableColumn fx:id="colActualizacion" text="Actualizado el" prefWidth="245.0"/>
        </columns>

        <placeholder>
            <Label text="No hay clientes para mostrar"/>
        </placeholder>
    </TableView>
</VBox>